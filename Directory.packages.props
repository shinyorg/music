<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0"/>
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50"/>
        <PackageVersion Include="Shiny.Maui.Controls" Version="1.0.1-beta-0041"/>
        <PackageVersion Include="Shiny.Maui.Shell" Version="6.0.2"/>
        <PackageVersion Include="SwiftBindings.MusicKit" Version="26.2.0"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.18.0"/>
        <PackageVersion Include="Xamarin.AndroidX.Fragment" Version="1.8.8.1"/>
    </ItemGroup>
</Project>