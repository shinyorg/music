<?xml version="1.0" encoding="UTF-8"?>
<metadata>
    <!--
      Several protocol "types" declare an instance field whose name matches the
      enclosing class (e.g. class Uri has field 'uri'). C# forbids a member with
      the same name as its type (CS0542), so rename the managed member.
    -->
    <attr path="/api/package[@name='com.spotify.protocol.types']/class[@name='Uri']/field[@name='uri']" name="managedName">Value</attr>
    <attr path="/api/package[@name='com.spotify.protocol.types']/class[@name='Uris']/field[@name='uris']" name="managedName">Values</attr>
    <attr path="/api/package[@name='com.spotify.protocol.types']/class[@name='Repeat']/field[@name='repeat']" name="managedName">Value</attr>
    <attr path="/api/package[@name='com.spotify.protocol.types']/class[@name='Shuffle']/field[@name='shuffle']" name="managedName">Value</attr>
    <attr path="/api/package[@name='com.spotify.protocol.types']/class[@name='Message']/field[@name='message']" name="managedName">Value</attr>
    <attr path="/api/package[@name='com.spotify.protocol.types']/class[@name='PlaybackSpeed']/field[@name='playbackSpeed']" name="managedName">Value</attr>
</metadata>
