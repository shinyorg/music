<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MusicSample"
             x:Class="MusicSample.MainPage"
             Title="Shiny Music"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,16,16,0" RowSpacing="8">

        <!-- Permission Banner -->
        <Button Grid.Row="0"
                Text="Grant Music Library Access"
                Command="{Binding RequestPermissionCommand}"
                IsVisible="{Binding NeedsPermission}"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="44" />

        <!-- Category Tabs -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Library"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="Library"
                        CornerRadius="16" HeightRequest="34" FontSize="13" Padding="14,0" />
                <Button Text="Playlists"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="Playlists"
                        CornerRadius="16" HeightRequest="34" FontSize="13" Padding="14,0" />
                <Button Text="Genres"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="Genres"
                        CornerRadius="16" HeightRequest="34" FontSize="13" Padding="14,0" />
                <Button Text="Decades"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="Decades"
                        CornerRadius="16" HeightRequest="34" FontSize="13" Padding="14,0" />
                <Button Text="Years"
                        Command="{Binding SelectCategoryCommand}" CommandParameter="Years"
                        CornerRadius="16" HeightRequest="34" FontSize="13" Padding="14,0" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Search Bar -->
        <Entry x:Name="SearchEntry"
               Grid.Row="2"
               Placeholder="Search songs, artists, albums..."
               ReturnType="Search"
               ClearButtonVisibility="WhileEditing"
               Completed="OnSearchCompleted" />

        <!-- Content Area -->
        <Grid Grid.Row="3">

            <!-- Track List (Library / Search results) -->
            <CollectionView ItemsSource="{Binding Tracks}"
                            SelectionMode="Single"
                            SelectionChanged="OnTrackSelected"
                            IsVisible="{Binding ShowGroups, Converter={StaticResource InvertBool}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                            <Image Source="{Binding AlbumArt}"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="6" Rect="0,0,44,44" />
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       LineBreakMode="TailTruncation" />
                                <Label FontSize="13" TextColor="Gray" LineBreakMode="TailTruncation">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Artist}" />
                                            <Span Text=" — " />
                                            <Span Text="{Binding Album}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}"
                                   VerticalOptions="Center"
                                   FontSize="13"
                                   TextColor="Gray" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No tracks found"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="Gray"
                           Margin="20" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Group List -->
            <CollectionView ItemsSource="{Binding Groups}"
                            SelectionMode="Single"
                            SelectionChanged="OnGroupSelected"
                            IsVisible="{Binding ShowGroups}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnDefinitions="*,Auto,Auto">
                            <Label Text="{Binding DisplayName}"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Count}"
                                   FontSize="13"
                                   TextColor="Gray"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text=">"
                                   FontSize="16"
                                   TextColor="Gray"
                                   VerticalOptions="Center"
                                   Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Player Bar - sits in its own row, no overlay -->
        <local:PlayerSheet Grid.Row="4" BindingContext="{Binding Player}" />
    </Grid>

</ContentPage>
