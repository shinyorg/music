<?xml version="1.0" encoding="utf-8" ?>
<fp:ShinyContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fp="clr-namespace:Shiny.Maui.Controls.FloatingPanel;assembly=Shiny.Maui.Controls"
             xmlns:local="clr-namespace:MusicSample"
             x:Class="MusicSample.MainPage"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <fp:ShinyContentPage.Panels>
        <local:PlayerSheet BindingContext="{Binding Player}" />
    </fp:ShinyContentPage.Panels>

    <fp:ShinyContentPage.PageContent>
    <Grid>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,12,16,0" RowSpacing="12">

        <!-- Custom Navigation Bar -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#1E1E2E, Dark=#1A1A2C}"
                Margin="-16,-12,-16,0"
                Padding="16,16,16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,16,16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="2">
                <Label Text="Shiny Music"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="{Binding SelectedCategory}"
                           FontSize="14"
                           TextColor="#A29BFE"
                           VerticalOptions="Center" />
                    <Label Text="&#x25BE;"
                           FontSize="14"
                           TextColor="#A29BFE"
                           VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowCategoryPickerCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Permission Banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding NeedsPermission}"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Grant Music Library Access"
                       TextColor="White"
                       FontSize="15"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Allow"
                        Command="{Binding RequestPermissionCommand}"
                        BackgroundColor="White"
                        TextColor="{StaticResource Primary}"
                        CornerRadius="16"
                        HeightRequest="32"
                        FontSize="13"
                        Padding="16,0" />
            </Grid>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                Padding="4,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
            </Border.Shadow>
            <Entry x:Name="SearchEntry"
                   Placeholder="Search songs, artists, albums..."
                   ReturnType="Search"
                   ClearButtonVisibility="WhileEditing"
                   Completed="OnSearchCompleted"
                   BackgroundColor="Transparent"
                   FontSize="15" />
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="3">

            <!-- Track List -->
            <CollectionView ItemsSource="{Binding Tracks}"
                            SelectionMode="Single"
                            SelectionChanged="OnTrackSelected"
                            IsVisible="{Binding ShowGroups, Converter={StaticResource InvertBool}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                                Margin="0,3"
                                Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                <Border StrokeThickness="0"
                                        WidthRequest="48"
                                        HeightRequest="48">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                                    </Border.Shadow>
                                    <Image Source="{Binding AlbumArt}"
                                           WidthRequest="48"
                                           HeightRequest="48"
                                           Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation" />
                                    <Label FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                           LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Artist}" />
                                                <Span Text=" - " />
                                                <Span Text="{Binding Album}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}"
                                       VerticalOptions="Center"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="40">
                        <Label Text="No tracks found"
                               HorizontalTextAlignment="Center"
                               FontSize="16"
                               TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Group List -->
            <CollectionView ItemsSource="{Binding Groups}"
                            SelectionMode="Single"
                            SelectionChanged="OnGroupSelected"
                            IsVisible="{Binding ShowGroups}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                                Margin="0,3"
                                Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding DisplayName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}"
                                        Padding="10,4"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Count}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Border>
                                <Label Grid.Column="2"
                                       Text=">"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray400}"
                                       VerticalOptions="Center"
                                       Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </Grid>

    <!-- Loading Overlay -->
    <Grid IsVisible="{Binding IsBusy}"
          BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}"
          InputTransparent="False">
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HeightRequest="48"
                           WidthRequest="48"
                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Grid>
    </Grid>
    </fp:ShinyContentPage.PageContent>

</fp:ShinyContentPage>
