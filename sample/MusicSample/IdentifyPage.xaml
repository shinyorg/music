<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MusicSample"
             x:Class="MusicSample.IdentifyPage"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- Header -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#1E1E2E, Dark=#1A1A2C}"
                Padding="16,16,16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,16,16" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*">
                <Label Text="&#x2190;"
                       FontSize="22"
                       TextColor="White"
                       VerticalOptions="Center"
                       Padding="0,0,12,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1"
                       Text="Identify Song"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24,32,24,24">
            <VerticalStackLayout VerticalOptions="Center" Spacing="24">

                <!-- Listening Animation / Listen Button -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="16"
                                     IsVisible="{Binding HasResult, Converter={StaticResource InvertBool}}">

                    <!-- Pulsing circle button -->
                    <Border StrokeThickness="0"
                            WidthRequest="160"
                            HeightRequest="160"
                            HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="80" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    Offset="0,4" Radius="24" Opacity="0.4" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ListenCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                            <Label Text="{Binding IsListening, Converter={local:ListeningIconConverter}}"
                                   FontSize="40"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding IsListening, Converter={local:ListeningTextConverter}}"
                                   FontSize="13"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Status text -->
                    <Label Text="{Binding StatusText}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                    <!-- Activity indicator while listening -->
                    <ActivityIndicator IsRunning="{Binding IsListening}"
                                       IsVisible="{Binding IsListening}"
                                       HorizontalOptions="Center"
                                       HeightRequest="32"
                                       WidthRequest="32"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </VerticalStackLayout>

                <!-- Result Card -->
                <Border StrokeThickness="0"
                        IsVisible="{Binding HasResult}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Padding="24,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.1" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">

                        <!-- Artwork -->
                        <Border StrokeThickness="0"
                                HorizontalOptions="Center"
                                WidthRequest="200"
                                HeightRequest="200"
                                IsVisible="{Binding ArtworkSource, Converter={local:NotNullConverter}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark=Black}"
                                        Offset="0,6" Radius="16" Opacity="0.25" />
                            </Border.Shadow>
                            <Image Source="{Binding ArtworkSource}"
                                   Aspect="AspectFill"
                                   WidthRequest="200"
                                   HeightRequest="200" />
                        </Border>

                        <!-- Track Info -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Artist}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Album}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Genre}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Open in Music App -->
                        <Button Text="Open in Music"
                                FontSize="15"
                                FontAttributes="Bold"
                                IsVisible="{Binding MusicUrl, Converter={local:NotNullConverter}}"
                                Command="{Binding OpenMusicUrlCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="44">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        Offset="0,4" Radius="12" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>

                        <!-- Try Again -->
                        <Button Text="Try Again"
                                FontSize="15"
                                FontAttributes="Bold"
                                Command="{Binding ListenCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                CornerRadius="12"
                                HeightRequest="44">
                            <Button.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                            </Button.Shadow>
                        </Button>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
