<?xml version="1.0" encoding="UTF-8" ?>
<shiny:ShinyShell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
    xmlns:local="clr-namespace:MusicSample"
    xmlns:spotify="clr-namespace:MusicSample.Spotify"
    x:Class="MusicSample.AppShell"
    Title="Shiny Music">

    <ShellContent
        Title="Library"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Ducking"
        ContentTemplate="{DataTemplate local:DuckTestPage}"
        Route="DuckTestPage" />

    <ShellContent
        Title="Spotify"
        ContentTemplate="{DataTemplate spotify:SpotifyPage}"
        Route="SpotifyPage" />

</shiny:ShinyShell>
