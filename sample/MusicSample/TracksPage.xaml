<?xml version="1.0" encoding="utf-8" ?>
<fp:ShinyContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fp="clr-namespace:Shiny.Maui.Controls.FloatingPanel;assembly=Shiny.Maui.Controls"
             xmlns:local="clr-namespace:MusicSample"
             x:Class="MusicSample.TracksPage"
             Title="{Binding Title}">

    <fp:ShinyContentPage.Panels>
        <local:PlayerSheet BindingContext="{Binding Player}" />
    </fp:ShinyContentPage.Panels>

    <fp:ShinyContentPage.PageContent>
        <Grid Padding="16,8,16,0">
            <CollectionView ItemsSource="{Binding Tracks}"
                            SelectionMode="Single"
                            SelectionChanged="OnTrackSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                            <Image Source="{Binding AlbumArt}"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="6" Rect="0,0,44,44" />
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       LineBreakMode="TailTruncation" />
                                <Label FontSize="13" TextColor="Gray" LineBreakMode="TailTruncation">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Artist}" />
                                            <Span Text=" — " />
                                            <Span Text="{Binding Album}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       HorizontalTextAlignment="End" />
                                <Label Text="{Binding PlayCount, StringFormat='{0} plays'}"
                                       FontSize="11"
                                       TextColor="Gray"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No tracks"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="Gray"
                           Margin="20" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </fp:ShinyContentPage.PageContent>

</fp:ShinyContentPage>
