<?xml version="1.0" encoding="utf-8" ?>
<fp:FloatingPanel xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:fp="clr-namespace:Shiny.Maui.Controls.FloatingPanel;assembly=Shiny.Maui.Controls"
                     x:Class="MusicSample.PlayerSheet"
                     IsOpen="{Binding IsSheetOpen, Mode=TwoWay}"
                     ShowHeaderWhenClosed="True"
                     HasBackdrop="True"
                     CloseOnBackdropTap="True"
                     PanelCornerRadius="24"
                     PanelBackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                     HandleColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                     HeaderBackgroundColor="{AppThemeBinding Light=#1E1E2E, Dark=#1A1A2C}"
                     Position="Bottom">

    <fp:FloatingPanel.PanelContent>
        <ScrollView>
            <VerticalStackLayout Padding="24,8,24,40" Spacing="20">

                <!-- Album Art -->
                <Border StrokeThickness="0"
                        HorizontalOptions="Center"
                        WidthRequest="280"
                        HeightRequest="280">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark=Black}"
                                Offset="0,8" Radius="24" Opacity="0.3" />
                    </Border.Shadow>
                    <Image Source="{Binding AlbumArtSource}"
                           Aspect="AspectFill"
                           WidthRequest="280"
                           HeightRequest="280" />
                </Border>

                <!-- Track Info -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="{Binding NowPlayingTitle}"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding NowPlayingArtist}"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding NowPlayingAlbum}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           HorizontalTextAlignment="Center" />
                    <Label FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Plays: " />
                                <Span Text="{Binding PlayCount}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- Seek Bar -->
                <Grid ColumnDefinitions="40,*,40" ColumnSpacing="4">
                    <Label Text="{Binding PositionText}"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding SliderValue}"
                            DragStarted="OnDragStarted"
                            DragCompleted="OnDragCompleted"
                            ValueChanged="OnSliderValueChanged"
                            MinimumTrackColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                    <Label Text="{Binding DurationText}"
                           Grid.Column="2"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Playback Controls -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                    <Button Text="⏹"
                            FontSize="24"
                            WidthRequest="52"
                            HeightRequest="52"
                            CornerRadius="26"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                            Command="{Binding StopCommand}">
                        <Button.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1" />
                        </Button.Shadow>
                    </Button>
                    <Button Text="{Binding PlayPauseIcon}"
                            FontSize="30"
                            WidthRequest="64"
                            HeightRequest="64"
                            CornerRadius="32"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="White"
                            Command="{Binding PlayPauseCommand}">
                        <Button.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    Offset="0,4" Radius="12" Opacity="0.4" />
                        </Button.Shadow>
                    </Button>
                </HorizontalStackLayout>

                <!-- Duck + Announce Button -->
                <Button Text="🔊 Announce Over Music"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        CornerRadius="12"
                        HeightRequest="44"
                        Command="{Binding DuckAndAnnounceCommand}">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

                <!-- Waveform + VU Button -->
                <Button Text="📊 Waveform &amp; VU"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        CornerRadius="12"
                        HeightRequest="44"
                        Clicked="OnWaveformClicked">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

                <!-- Lyrics Button -->
                <Button Text="View Lyrics"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        CornerRadius="12"
                        HeightRequest="44"
                        IsVisible="{Binding HasLyrics}"
                        Clicked="OnLyricsClicked">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>
    </fp:FloatingPanel.PanelContent>

</fp:FloatingPanel>
