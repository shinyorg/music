<?xml version="1.0" encoding="utf-8"?>
<shiny:ShinyContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:local="clr-namespace:MusicSample"
                        xmlns:shiny="http://shiny.net/maui/controls"
                        x:Class="MusicSample.DuckTestPage"
                        x:DataType="local:DuckTestViewModel"
                        Title="Ducking">

    <shiny:ShinyContentPage.PageContent>
        <Grid>
            <Grid RowDefinitions="Auto,*" Padding="16,12,16,0" RowSpacing="12">

                <!-- Announcement + Controls -->
                <VerticalStackLayout Grid.Row="0" Spacing="12">

                    <!-- Permission Banner -->
                    <Border IsVisible="{Binding NeedsPermission}"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            Padding="16,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="Music library access is required to pick a track."
                               TextColor="White"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Announcement Text -->
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Editor Text="{Binding AnnouncementText}"
                                Placeholder="Type what should be spoken over the music..."
                                AutoSize="TextChanges"
                                MinimumHeightRequest="80"
                                BackgroundColor="Transparent"
                                FontSize="15" />
                    </Border>

                    <!-- Duck Level -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Duck level"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding DuckLevel}"
                                MinimumTrackColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        <Label Grid.Column="2"
                               Text="{Binding DuckLevelText}"
                               FontSize="14"
                               FontAttributes="Bold"
                               WidthRequest="44"
                               HorizontalTextAlignment="End"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Speak & Duck -->
                    <Button Text="🔊 Speak &amp; Duck Music"
                            FontSize="16"
                            FontAttributes="Bold"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="48"
                            IsEnabled="{Binding IsSpeaking, Converter={StaticResource InvertBool}}"
                            Command="{Binding SpeakAndDuckCommand}" />

                    <!-- Now Playing -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="{Binding NowPlaying}"
                               FontSize="13"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Stop"
                                FontSize="13"
                                HeightRequest="32"
                                Padding="14,0"
                                CornerRadius="10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                Command="{Binding StopMusicCommand}" />
                    </Grid>

                    <Label Text="Pick a track to play, then tap Speak &amp; Duck."
                           FontSize="12"
                           TextColor="{StaticResource Gray400}" />
                </VerticalStackLayout>

                <!-- Track Picker -->
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Tracks}"
                                SelectionMode="Single"
                                SelectionChanged="OnTrackSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:TrackItem">
                            <Grid Padding="8,8" ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                                <Image Source="{Binding AlbumArt}"
                                       WidthRequest="44"
                                       HeightRequest="44"
                                       Aspect="AspectFill">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="6" Rect="0,0,44,44" />
                                    </Image.Clip>
                                </Image>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Artist}"
                                           FontSize="13"
                                           TextColor="Gray"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No tracks"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TextColor="Gray"
                               Margin="20" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <!-- Loading Overlay -->
            <Grid IsVisible="{Binding IsBusy}"
                  BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HeightRequest="48"
                                   WidthRequest="48"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </Grid>
        </Grid>
    </shiny:ShinyContentPage.PageContent>

</shiny:ShinyContentPage>
