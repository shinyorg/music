<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-ios26.4;net10.0-maccatalyst26.4</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <RootNamespace>ShinyMusicKit</RootNamespace>
    <PackageId>Shiny.MusicKit.Binding</PackageId>
    <Description>Slim MusicKit binding for Shiny.Music — exposes Apple Music subscription status via MusicSubscription.</Description>
    <PackageTags>musickit;apple music;ios;maccatalyst;maui;shiny</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <XcodeProject Include="../native/ShinyMusicKit/ShinyMusicKit.xcodeproj">
      <SchemeName>ShinyMusicKit</SchemeName>
    </XcodeProject>
  </ItemGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
  </ItemGroup>
</Project>
