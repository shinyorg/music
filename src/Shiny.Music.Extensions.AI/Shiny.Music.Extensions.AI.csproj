<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Shiny.Music.Extensions.AI</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <Description>Microsoft.Extensions.AI tool surface for Shiny.Music — exposes the device music library and player as AIFunction tools for LLM tool-calling.</Description>
        <PackageTags>music media audio ai aifunction mcp maui shiny aot</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
        <ProjectReference Include="..\Shiny.Music\Shiny.Music.csproj" />
    </ItemGroup>

</Project>
